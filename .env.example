# ═══════════════════════════════════════════════════════════════════════════
# CraftX3D Studio — Environment Variables
# Copy this file to .env for local development (never commit the real .env).
# In production (Render), set these in the dashboard under Environment.
# ═══════════════════════════════════════════════════════════════════════════

# ── Django core ──────────────────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=craftix3d-change-this-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of full origins (with https://) allowed to POST forms.
# Needed in production once you have a real domain, e.g.:
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────
# OPTION A: SQLite (easiest — no install needed, great for local development)
USE_SQLITE=True

# OPTION B: PostgreSQL / Railway (recommended for production)
# Set USE_SQLITE=False and paste the connection string Railway gives you:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Media storage — Cloudinary ──────────────────────────────────────────
# From cloudinary.com dashboard → copy the single "API Environment variable".
# Leave blank locally to just use the local media/ folder. REQUIRED in
# production on Render, since its filesystem is wiped on every redeploy.
# Use EITHER the single combined URL, OR the three separate variables below
# (both work — pick whichever your setup already has):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=<cloud_name>
# CLOUDINARY_API_KEY=<api_key>
# CLOUDINARY_API_SECRET=<api_secret>

# ── Razorpay — online payments ──────────────────────────────────────────
# From Razorpay Dashboard → Settings → API Keys.
# Use test mode keys (rzp_test_...) until you're ready to go live (rzp_live_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay Dashboard → Webhooks). URL: https://<domain>/razorpay/webhook/
RAZORPAY_WEBHOOK_SECRET=

# ── Google login ─────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Manage portal staff login ───────────────────────────────────────────
# Creates/resets the /manage/login/ admin account automatically on every
# deploy (needed on free hosting plans that don't give you shell access).
# Safe to leave these set permanently — re-running just resets the password.
STAFF_ADMIN_USERNAME=admin
STAFF_ADMIN_PASSWORD=

# ── Order confirmation emails (optional — Brevo API) ────────────────────
# Uses Brevo's HTTPS API, not SMTP — Render's free tier blocks outbound SMTP
# ports entirely, so plain SMTP credentials won't work there. From Brevo →
# Settings (gear icon) → SMTP & API → API Keys tab (NOT the SMTP tab).
# Leave blank to skip sending emails entirely (the site works fully without
# this — customers can still view their invoice on the site).
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=CraftX3D <supportcraftx3dstudio@gmail.com>
